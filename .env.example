# Databricks 认证与连接
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CONFIG_PROFILE=

# Unity Catalog（结构化数据，复用已有目录）
UC_CATALOG=adventureworks_dataagent
UC_SCHEMA_SALES=sales
UC_SCHEMA_PERSON=person
UC_SCHEMA_PRODUCTION=production
UC_FUNCTION_SCHEMA=salesduo_agent_tools

# SQL Warehouse（Genie 查询用）
SQL_WAREHOUSE_ID=

# Genie Agent（结构化查询）
GENIE_SPACE_ID=

# 非结构化数据 / Vector Search
DOCS_SOURCE_DIR=documents_generated
UC_VOLUME_PATH=/Volumes/adventureworks_dataagent/salesduo_agent_tools/salesduo_docs_volume
DELTA_TABLE_DOCS_CHUNKS=adventureworks_dataagent.salesduo_agent_tools.salesduo_docs_chunks
VECTOR_SEARCH_ENDPOINT=salesduo-vs-endpoint
VECTOR_SEARCH_INDEX=adventureworks_dataagent.salesduo_agent_tools.salesduo_docs_index
EMBEDDING_MODEL_ENDPOINT=databricks-gte-large-en

# 编排用的 LLM
LLM_SERVING_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# MLflow / 评测 / 部署
MLFLOW_EXPERIMENT_PATH=/Shared/salesduo-agent
MODEL_SERVING_ENDPOINT_NAME=salesduo-agent
DATABRICKS_APP_NAME=salesduo-agent

# 编排安全阀
MAX_ROUTER_LOOPS=5
