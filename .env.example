# Databricks auth and connection (native Azure auth — no explicit PAT token)
# This machine needs the Azure CLI installed with `az login` already run. databricks-sdk
# uses the three Azure resource coordinates below to resolve the workspace host via
# Azure Resource Manager, and authenticates by reusing the Azure AD session left by
# `az login`.
AZURE_SUBSCRIPTION_ID=
RESOURCE_GROUP_NAME=
DATABRICKS_WORKSPACE_NAME=
DATABRICKS_CONFIG_PROFILE=   # Optional, used when authenticating via a ~/.databrickscfg profile; takes priority over the three variables above

# Unity Catalog (structured data — reuses an existing catalog)
UC_CATALOG=adventureworks_dataagent
UC_SCHEMA_SALES=sales
UC_SCHEMA_PERSON=person
UC_SCHEMA_PRODUCTION=production
UC_FUNCTION_SCHEMA=salesduo_agent_tools

# SQL Warehouse (used for Genie queries)
SQL_WAREHOUSE_ID=

# Genie Agent (structured queries)
GENIE_SPACE_ID=

# Unstructured data / Vector Search
DOCS_SOURCE_DIR=documents_generated
UC_VOLUME_PATH=/Volumes/adventureworks_dataagent/salesduo_agent_tools/salesduo_docs_volume
DELTA_TABLE_DOCS_CHUNKS=adventureworks_dataagent.salesduo_agent_tools.salesduo_docs_chunks
VECTOR_SEARCH_ENDPOINT=salesduo-vs-endpoint
VECTOR_SEARCH_INDEX=adventureworks_dataagent.salesduo_agent_tools.salesduo_docs_index
EMBEDDING_MODEL_ENDPOINT=databricks-gte-large-en

# LLM used for orchestration
LLM_SERVING_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# MLflow / evaluation / deployment
MLFLOW_EXPERIMENT_PATH=/Shared/salesduo-agent
MODEL_SERVING_ENDPOINT_NAME=salesduo-agent
DATABRICKS_APP_NAME=salesduo-agent

# Orchestration safety valve
MAX_ROUTER_LOOPS=5
